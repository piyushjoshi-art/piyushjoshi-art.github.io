<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Gallery | Royal Bites</title>
<meta name="description" content="Explore the Royal Bites food, restaurant ambience and dessert gallery.">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#111;
    color:#fff;
    line-height:1.6;
}

/* NAVBAR */

nav{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(15,15,15,.96);
    backdrop-filter:blur(10px);
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid rgba(212,175,55,.2);
}

.logo{
    color:#d4af37;
    text-decoration:none;
    font-size:25px;
    font-weight:bold;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:#fff;
    text-decoration:none;
    font-size:15px;
    transition:.3s;
}

.nav-links a:hover,
.nav-links .active{
    color:#d4af37;
}

/* HERO */

.hero{
    min-height:55vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:80px 20px;
    background:
    linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.82)),
    url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1800&q=85");
    background-size:cover;
    background-position:center;
}

.hero h1{
    font-size:58px;
    margin-bottom:15px;
}

.hero h1 span{
    color:#d4af37;
}

.hero p{
    color:#ddd;
    font-size:18px;
}

/* GALLERY */

.gallery-section{
    padding:80px 7%;
}

/* FILTERS */

.filters{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
    margin-bottom:40px;
}

.filter-btn{
    background:#191919;
    color:#ddd;
    border:1px solid #333;
    padding:10px 22px;
    border-radius:25px;
    cursor:pointer;
    transition:.3s;
}

.filter-btn:hover,
.filter-btn.active{
    background:#d4af37;
    color:#111;
    border-color:#d4af37;
}

/* GRID */

.gallery-grid{
    max-width:1300px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.gallery-item{
    position:relative;
    height:270px;
    overflow:hidden;
    border-radius:15px;
    cursor:pointer;
    background:#191919;
    border:1px solid #292929;
}

.gallery-item img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:.5s;
}

.gallery-overlay{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.65);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    opacity:0;
    transition:.3s;
}

.gallery-overlay h3{
    color:#fff;
    font-size:20px;
}

.gallery-overlay p{
    color:#d4af37;
    font-size:14px;
}

.gallery-item:hover img{
    transform:scale(1.08);
}

.gallery-item:hover .gallery-overlay{
    opacity:1;
}

/* CTA */

.cta{
    text-align:center;
    padding:80px 7%;
    background:#0d0d0d;
}

.cta h2{
    color:#d4af37;
    font-size:40px;
    margin-bottom:12px;
}

.cta p{
    color:#aaa;
    max-width:650px;
    margin:0 auto 25px;
}

.btn{
    display:inline-block;
    padding:13px 27px;
    background:#d4af37;
    color:#111;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    background:#fff;
    transform:translateY(-3px);
}

/* LIGHTBOX */

.lightbox{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.92);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:2000;
    padding:25px;
}

.lightbox.show{
    display:flex;
}

.lightbox img{
    max-width:90%;
    max-height:85vh;
    border-radius:12px;
    box-shadow:0 10px 50px rgba(0,0,0,.7);
}

.close{
    position:absolute;
    top:25px;
    right:35px;
    font-size:40px;
    color:#fff;
    cursor:pointer;
}

.close:hover{
    color:#d4af37;
}

/* FOOTER */

footer{
    background:#090909;
    padding:40px 7%;
    text-align:center;
    border-top:1px solid #222;
}

footer .logo{
    display:inline-block;
    margin-bottom:15px;
}

.footer-links{
    margin:15px 0;
}

.footer-links a{
    color:#aaa;
    text-decoration:none;
    margin:0 8px;
}

.footer-links a:hover{
    color:#d4af37;
}

footer p{
    color:#777;
    font-size:14px;
}

/* WHATSAPP */

.whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    width:55px;
    height:55px;
    border-radius:50%;
    background:#25D366;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:24px;
    z-index:1500;
}

/* TABLET */

@media(max-width:1000px){

    .nav-links{
        gap:12px;
    }

    .nav-links a{
        font-size:12px;
    }

    .gallery-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

/* MOBILE */

@media(max-width:600px){

    nav{
        padding:15px 4%;
    }

    .logo{
        font-size:20px;
    }

    .nav-links{
        display:none;
    }

    .hero{
        min-height:45vh;
    }

    .hero h1{
        font-size:38px;
    }

    .hero p{
        font-size:15px;
    }

    .gallery-section{
        padding:60px 5%;
    }

    .gallery-grid{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .gallery-item{
        height:190px;
    }

    .gallery-overlay{
        opacity:1;
        background:linear-gradient(
            transparent,
            rgba(0,0,0,.75)
        );
        justify-content:flex-end;
        align-items:flex-start;
        padding:12px;
    }

    .gallery-overlay h3{
        font-size:15px;
    }

    .gallery-overlay p{
        font-size:12px;
    }

    .close{
        top:15px;
        right:20px;
        font-size:35px;
    }

    .cta{
        padding:65px 5%;
    }

    .cta h2{
        font-size:30px;
    }

}

</style>
</head>

<body>


<!-- NAVBAR -->

<nav>

<a href="index.html" class="logo">
Royal Bites
</a>

<ul class="nav-links">

<li>
<a href="index.html">Home</a>
</li>

<li>
<a href="menu.html">Menu</a>
</li>

<li>
<a href="about.html">About</a>
</li>

<li>
<a href="gallery.html" class="active">Gallery</a>
</li>

<li>
<a href="reservation.html">Reservation</a>
</li>

<li>
<a href="contact.html">Contact</a>
</li>

</ul>

</nav>


<!-- HERO -->

<section class="hero">

<div>

<h1>
Our <span>Gallery</span>
</h1>

<p>
A glimpse of our food, ambience and special moments.
</p>

</div>

</section>


<!-- GALLERY -->

<section class="gallery-section">


<!-- FILTERS -->

<div class="filters">

<button
class="filter-btn active"
onclick="filterGallery('all',this)">
All
</button>

<button
class="filter-btn"
onclick="filterGallery('food',this)">
Food
</button>

<button
class="filter-btn"
onclick="filterGallery('restaurant',this)">
Restaurant
</button>

<button
class="filter-btn"
onclick="filterGallery('dessert',this)">
Desserts
</button>

</div>


<!-- GALLERY GRID -->

<div class="gallery-grid">


<div
class="gallery-item"
data-category="restaurant"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1000&q=85"
alt="Restaurant interior"
>

<div class="gallery-overlay">

<h3>Restaurant Ambience</h3>
<p>Restaurant</p>

</div>

</div>


<div
class="gallery-item"
data-category="food"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1000&q=85"
alt="Delicious food"
>

<div class="gallery-overlay">

<h3>Signature Dish</h3>
<p>Food</p>

</div>

</div>


<div
class="gallery-item"
data-category="food"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1000&q=85"
alt="Restaurant food"
>

<div class="gallery-overlay">

<h3>Chef's Special</h3>
<p>Food</p>

</div>

</div>


<div
class="gallery-item"
data-category="dessert"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=1000&q=85"
alt="Dessert"
>

<div class="gallery-overlay">

<h3>Sweet Treat</h3>
<p>Desserts</p>

</div>

</div>


<div
class="gallery-item"
data-category="restaurant"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1000&q=85"
alt="Restaurant dining"
>

<div class="gallery-overlay">

<h3>Elegant Dining</h3>
<p>Restaurant</p>

</div>

</div>


<div
class="gallery-item"
data-category="food"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1567188040759-fb8a883dc6d8?auto=format&fit=crop&w=1000&q=85"
alt="Paneer dish"
>

<div class="gallery-overlay">

<h3>Paneer Tikka</h3>
<p>Food</p>

</div>

</div>


<div
class="gallery-item"
data-category="dessert"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1000&q=85"
alt="Chocolate cake"
>

<div class="gallery-overlay">

<h3>Signature Cake</h3>
<p>Desserts</p>

</div>

</div>


<div
class="gallery-item"
data-category="restaurant"
onclick="openLightbox(this)"
>

<img
src="https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1000&q=85"
alt="Restaurant interior"
>

<div class="gallery-overlay">

<h3>Dining Experience</h3>
<p>Restaurant</p>

</div>

</div>


</div>

</section>


<!-- CTA -->

<section class="cta">

<h2>Hungry Yet?</h2>

<p>
Explore our complete menu and discover your next favourite dish.
</p>

<a href="menu.html" class="btn">
Explore Menu
</a>

<a href="reservation.html" class="btn">
Reserve Table
</a>

</section>


<!-- LIGHTBOX -->

<div
class="lightbox"
id="lightbox"
onclick="closeLightbox(event)"
>

<span
class="close"
onclick="closeLightbox(event)">
&times;
</span>

<img id="lightboxImage" src="" alt="Gallery preview">

</div>


<!-- FOOTER -->

<footer>

<a href="index.html" class="logo">
Royal Bites
</a>

<div class="footer-links">

<a href="index.html">Home</a>
<a href="menu.html">Menu</a>
<a href="about.html">About</a>
<a href="gallery.html">Gallery</a>
<a href="reservation.html">Reservation</a>
<a href="contact.html">Contact</a>

</div>

<p>
© 2026 Royal Bites. All Rights Reserved.
</p>

</footer>


<!-- WHATSAPP -->

<a
href="https://wa.me/919999999999"
class="whatsapp"
target="_blank">
☎
</a>


<script>

/* FILTER GALLERY */

function filterGallery(category, button){

    let items =
    document.querySelectorAll(".gallery-item");

    let buttons =
    document.querySelectorAll(".filter-btn");

    buttons.forEach(function(btn){
        btn.classList.remove("active");
    });

    button.classList.add("active");

    items.forEach(function(item){

        if(
            category === "all" ||
            item.dataset.category === category
        ){

            item.style.display = "block";

        }else{

            item.style.display = "none";

        }

    });

}


/* LIGHTBOX */

function openLightbox(item){

    let image =
    item.querySelector("img");

    document.getElementById("lightboxImage").src =
    image.src;

    document.getElementById("lightbox").classList.add("show");

}


function closeLightbox(event){

    if(
        event.target.id === "lightbox" ||
        event.target.classList.contains("close")
    ){

        document
        .getElementById("lightbox")
        .classList.remove("show");

    }

}


/* ESC KEY */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            document
            .getElementById("lightbox")
            .classList.remove("show");

        }

    }
);

</script>

</body>
</html>
